<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Xamarin_Postep.Views.ListToAdd.AddQuestPage">
    <ContentPage.Content>
        <StackLayout>
            <Label Text="Dodaj Zadanie"/>
            <Entry Text="{Binding QuestContent}"/>
            <TimePicker Time="{Binding TimeContent}" Format="HH:mm"/>
            <Button Command="{Binding OnQuestAdd}" BackgroundColor="Gray" VerticalOptions="EndAndExpand" Text="Dodaj" Margin="20"/>
        </StackLayout>
    </ContentPage.Content>
</ContentPage>
    