<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Xamarin_Postep.Views.ListToAdd.AddNoticePage">
    <ContentPage.Content>
        <StackLayout>
            <Entry Text="{Binding Theme}" Placeholder="Temat"/>
            <Frame BorderColor="Black" Margin="10">
            <Editor Text="{Binding Note}" HeightRequest="500"/>
            </Frame>
            <Button Text="Dodaj" BackgroundColor="Gray" Command="{Binding AddNewNotice}" VerticalOptions="EndAndExpand" />
        </StackLayout>
    </ContentPage.Content>
</ContentPage>