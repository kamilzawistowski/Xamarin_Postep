<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Xamarin_Postep.Views.ListToAdd.AddNoticePage">
    <ContentPage.Content>
        <StackLayout>
            <Label Text="Dodaj Notatke" FontSize="Title" HorizontalOptions="Center" Margin="20" />
            <Editor Text="{Binding NoticeContent}" HeightRequest="300"/>
            <Button Command="{Binding OnNoticeAdd}" BackgroundColor="Gray" VerticalOptions="EndAndExpand" Margin="20" Text="Dodaj"></Button>
        </StackLayout>
    </ContentPage.Content>
</ContentPage>