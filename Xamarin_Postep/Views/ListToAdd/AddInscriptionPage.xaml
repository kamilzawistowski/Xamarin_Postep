<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Xamarin_Postep.Views.ListToAdd.AddInscriptionPage">
    <ContentPage.Content>
        <StackLayout>
            <Label Text="Dodaj Wpis" FontSize="Title" HorizontalOptions="Center" Margin="20" />
            <Frame BorderColor="Black" Margin="10">
                <Editor Text="{Binding InscriptionContent}" HeightRequest="300"/>
            </Frame>
            <Button Command="{Binding OnInscriptionAdd}" BackgroundColor="Gray" VerticalOptions="EndAndExpand" Margin="20" Text="Dodaj"></Button>
        </StackLayout>
    </ContentPage.Content>
</ContentPage>