<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:xc="clr-namespace:XCalendar;assembly=XCalendar"
             x:Class="Xamarin_Postep.Views.Main3Days.TodayPage"
             xmlns:models="clr-namespace:Xamarin_Postep.Models"
             BackgroundColor="#fff"
             >
    
    <ContentPage.Content>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="150" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

          
                
            <StackLayout Grid.Row="0"  Margin="30">
                <Label Text="{Binding DateTimeNowDay}" FontSize="Title" FontFamily="Constantia.ttf" TextColor="#000" HorizontalOptions="Center"  ></Label>
                <Label FontFamily="Arial" Text="{Binding DateTimeNowNumberAndMonth}" FontSize="Title" TextColor="#000" HorizontalOptions="Center"  ></Label>
        </StackLayout>
            
            <CollectionView Grid.Row="1" ItemsSource="{Binding QuestList}" Margin="5" >
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="20"/>
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate >
                    <DataTemplate>
                        <Frame  Padding="2"  x:DataType="models:Quest" BorderColor="Black">
                            <StackLayout Orientation="Vertical" Margin="5"  >
                                    <StackLayout Orientation="Horizontal" >
                                    <CheckBox Margin="20,0,0,0" IsChecked="{Binding IsComplete}" CheckedChanged="CheckBox_CheckedChanged"/>
                                    <Label Text="{Binding Content}" FontAttributes="Bold" HorizontalOptions="CenterAndExpand" FontSize="Medium"/>
                                    </StackLayout>
                                
                            </StackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>


            <!--<CollectionView Grid.Row="1" ItemsSource="{Binding QuestList}" Margin="5" >
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="20"/>
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate >
                    <DataTemplate>
                        <Frame  Padding="2"  x:DataType="models:Quest" BorderColor="Black">
                            <StackLayout Orientation="Vertical" Margin="5"  >
                                <StackLayout Orientation="Horizontal" >
                                    <CheckBox Margin="20,0,0,0" IsChecked="{Binding IsComplete}" CheckedChanged="CheckBox_CheckedChanged"/>
                                    <Label Text="{Binding Content}" FontAttributes="Bold" HorizontalOptions="CenterAndExpand" FontSize="Medium"/>
                                </StackLayout>

                            </StackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>-->
            
            
            
            <!--<Button Text="Notify" Grid.Row="1" BackgroundColor="Gray" Clicked="Button_Clicked"/>-->

            <Button Grid.Row="2"  HorizontalOptions="Start" VerticalOptions="End" Margin="20" ImageSource="icon_list.png" CornerRadius="90" Clicked="ShowApp_Click" />
            <Button Grid.Row="2"  HorizontalOptions="End" VerticalOptions="End" Margin="20" ImageSource="icon_plus.png" CornerRadius="90" Clicked="AddNew_Click"/>
        </Grid>
    </ContentPage.Content>
</ContentPage>