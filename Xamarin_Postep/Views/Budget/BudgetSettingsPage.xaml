<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Xamarin_Postep.Views.Budget.BudgetSettingsPage">
    <ContentPage.Content>
        <StackLayout>
            
            <Frame BorderColor="Black" Margin="10">
                <StackLayout>
                    <Label Text="Kategorie Wydatek" HorizontalOptions="Center" FontAttributes="Bold" FontSize="Medium"/>
                    <Entry Text="{Binding CategoryWydatek}"/>
                    <Button BackgroundColor="Gray" Text="Dodaj"/>
                    <CollectionView HeightRequest="100" ItemsSource="{Binding WydatekListt}">
                        
                    </CollectionView>

                </StackLayout>
            </Frame>

            <Frame BorderColor="Black" Margin="10">
                <StackLayout>
                    <Label Text="Kategorie Przychod" HorizontalOptions="Center" FontAttributes="Bold" FontSize="Medium"/>
                    <Entry Text="{Binding CategoryPrzychod}"/>
                    <Button BackgroundColor="Gray" Text="Dodaj"/>
                </StackLayout>
            </Frame>
        </StackLayout>
    </ContentPage.Content>
</ContentPage>