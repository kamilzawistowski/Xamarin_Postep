<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Xamarin_Postep.Views.ListToGO.Workouts.SettingsWorkoutPage">
    <ContentPage.Content>
        <StackLayout HorizontalOptions="CenterAndExpand">
            <Picker ItemsSource="{Binding BodyPartCollection,Mode=TwoWay}" SelectedItem="{Binding SelectedBodyPart}"/>
            <Label Text="Dodaj Nowe ćwiczenie"/>
            <Entry Text="{Binding NewExerciseEntry}"/>
            <Button Command="{Binding AddNewExerciseCommand}" Text="Dodaj" BorderColor="Black" BorderWidth="1"/>
        </StackLayout>
    </ContentPage.Content>
</ContentPage>