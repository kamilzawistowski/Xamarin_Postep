<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Xamarin_Postep.Views.ListToGO.Raports.RaportMainPage">
    <ContentPage.Content>
        <StackLayout>
            <Button Text="Wygeneruj Raport" HorizontalOptions="Center" Clicked="Button_Clicked" BackgroundColor="Gray"></Button>
            <Button Text="Wygeneruj Slowka" HorizontalOptions="Center" Clicked="Button_GenerateEnglishWords" BackgroundColor="Gray"></Button>
            <Button Text="Kopia zapasowa bazy danych" HorizontalOptions="Center" Clicked="Button_Clicked2" BackgroundColor="Gray" Margin="15"></Button>
            <Button Text="Select Photo" Clicked="SelectPhotoButton_Clicked" />
            <Image x:Name="image"/>
        </StackLayout>
    </ContentPage.Content>
</ContentPage>