<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Xamarin_Postep.Views.ListToGO.Progres.AddProcesPage">
    <ContentPage.Content>
        <StackLayout>
            <Label Text="Dodaj proces" />
            <Entry Placeholder="nazwa" Text="{Binding ProcesName}"/>
            <Picker SelectedItem="{Binding SelectedCategory}" ItemsSource="{Binding Categories}" />
            
        </StackLayout>
    </ContentPage.Content>
</ContentPage>