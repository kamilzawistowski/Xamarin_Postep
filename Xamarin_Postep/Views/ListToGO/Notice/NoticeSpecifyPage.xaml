<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Xamarin_Postep.Views.ListToGO.Notice.NoticeSpecifyPage">
    <Shell.BackButtonBehavior>
        <BackButtonBehavior 
            Command="{Binding BackButton}"/>
    </Shell.BackButtonBehavior>

    <ContentPage.ToolbarItems>
        <ToolbarItem IconImageSource="icon_list.png" Command="{Binding DeleteNotice}"/>
    </ContentPage.ToolbarItems>
    
    <ContentPage.Content>
        
        <StackLayout>
            <Editor Text="{Binding Theme}" HorizontalOptions="Center" FontSize="Title" TextColor="Black" Margin="10" FontAttributes="Bold" WidthRequest="180" HeightRequest="100"/>
            <Frame BorderColor="Black" Margin="20">
            <Editor Text="{Binding Note}" HeightRequest="400"/>
            </Frame>
        </StackLayout>
    </ContentPage.Content>
</ContentPage>