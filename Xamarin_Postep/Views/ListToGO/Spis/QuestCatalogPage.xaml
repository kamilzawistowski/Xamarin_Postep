<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Xamarin_Postep.Views.ListToGO.Spis.QuestCatalogPage"
             xmlns:models="clr-namespace:Xamarin_Postep.Models">
    <ContentPage.Content>
        <StackLayout>
            <CollectionView ItemsSource="{Binding Quest}" x:Name="QuestCatalog">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="20"/>
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate >
                    <DataTemplate >

                        <Frame BackgroundColor="Red" Padding="0,1,15,1"  BorderColor="Black">
                            <SwipeView>
                                <SwipeView.RightItems>
                                    <SwipeItems>
                                        <SwipeItemView
                                                Command="{Binding BindingContext.DeleteSelectedCommand, Source={x:Reference QuestCatalog}}"
                                                CommandParameter="{Binding}" 
                                                WidthRequest="64" HeightRequest="64">
                                            <StackLayout x:DataType="models:EnglishWord">
                                                <Label
                                                VerticalOptions="CenterAndExpand"
                                                BackgroundColor="Red"
                                                Text="Delete"
                                                TextColor="Black" />
                                            </StackLayout>
                                        </SwipeItemView>
                                    </SwipeItems>
                                </SwipeView.RightItems>

                                <Frame BorderColor="Black" Margin="5">
                                    <StackLayout Orientation="Horizontal">
                                        <Label Text="{Binding Content}" TextColor="Black"/>
                                        <Label HorizontalOptions="EndAndExpand" Text="{Binding Date, StringFormat='{}{0:MM/dd/yyyy}'}" TextColor="Black"/>
                                    </StackLayout>
                                </Frame>
                            </SwipeView>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </StackLayout>
    </ContentPage.Content>
</ContentPage>