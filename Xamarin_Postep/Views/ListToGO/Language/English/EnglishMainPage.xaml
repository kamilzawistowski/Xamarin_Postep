<?xml version="1.0" encoding="UTF-8"?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms" 
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Xamarin_Postep.Views.ListToGO.Language.English.EnglishMainPage">
    <Shell.BackButtonBehavior>
        <BackButtonBehavior 
            Command="{Binding BackButton}"/>
    </Shell.BackButtonBehavior>

    <ContentPage.ToolbarItems>
        <ToolbarItem IconImageSource="icon_list.png" Command="{Binding SettingCommand}">
        </ToolbarItem>
    </ContentPage.ToolbarItems>

    <ContentPage.Content>
        <StackLayout Orientation="Vertical">
            <Label Text="{Binding LabelTest}" x:Name="Labeltest"/>
            <Button HeightRequest="50" Style="{StaticResource ButtonBackgroundColor}" Text="Dodaj Slowka" Clicked="Click_AddWords" Margin="10"></Button>

            <Button Text="Lista Słowek" Clicked="WordsEnglishList"  Style="{StaticResource ButtonBackgroundColor}"  Margin="10"></Button>

            <Frame BorderColor="Black" Margin="15">
                <StackLayout HeightRequest="400">

                    <ListView x:Name="categoryCollection"
                        ItemsSource="{Binding Options}"
                              MinimumHeightRequest="300"
                    SelectedItem="{Binding SelectedOption}">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <TextCell Text="{Binding}" TextColor="Black" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Button HeightRequest="50"  Style="{StaticResource ButtonBackgroundColor}" Text="Test" Clicked="Click_Test"></Button>
                </StackLayout>
            </Frame>
        </StackLayout>
    </ContentPage.Content>
</ContentPage>